require('dotenv').config();
const express = require('express');
const cors = require('cors');
const { createClient } = require('@supabase/supabase-js');
const axios = require('axios');
const app = express();
app.use(cors());
app.use(express.json());
const supabase = createClient(process.env.SUPABASE_URL, process.env.SUPABASE_KEY);

app.get('/', (req,res)=> res.send('TILOBET Backend Live - Real Money API'));

app.get('/api/wallet/:user_id', async (req,res)=>{
  try{
    let { data } = await supabase.from('wallets').select('balance').eq('user_id', req.params.user_id).single();
    res.json(data || {balance:0});
  }catch(e){ res.json({balance:0}); }
});

